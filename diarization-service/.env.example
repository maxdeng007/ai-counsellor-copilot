# Copy to ".env" in this directory (never commit .env).
# Get Volc / Doubao ASR credentials from your ByteDance / Volc console.

VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
VOLC_SECRET_KEY=
VOLC_RESOURCE_ID=volc.bigasr.sauc.duration
VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# Meeting summary: openai | volc_ark (aliases: volc, ark, doubao)
SUMMARY_PROVIDER=openai
SUMMARY_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Volcano Ark (豆包) when SUMMARY_PROVIDER=volc_ark — API root only, not …/chat/completions
VOLC_ARK_API_KEY=
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# lite = Doubao-Seed-2.0-lite (default); mini = Doubao-Seed-2.0-mini
VOLC_ARK_MODEL_TIER=lite
# Or set explicit endpoint id (overrides VOLC_ARK_MODEL_TIER):
# VOLC_ARK_MODEL=ep-m-20260427181727-ms2s8
