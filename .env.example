VITE_DIARIZATION_API_BASE=http://localhost:8090
VITE_USE_VOLC=true
# Show live commit/preview debug counters in transcript header.
# VITE_SHOW_VOLC_DEBUG=true
VITE_CHUNK_MS=2000
# Mic: defaults are aggressive for quiet speech — reduce if clipping/noisy.
# VITE_MIC_GAIN=2.25
# VITE_MIC_TARGET_RMS=0.14
# VITE_MIC_MAX_NORMALIZE_GAIN=14
# Headset / max sensitivity: turn off browser echo cancellation.
# VITE_MIC_ECHO_CANCELLATION=false
# Use ScriptProcessor path by default for broad compatibility.
# VITE_USE_AUDIO_WORKLET=false

# Live preview / commit pacing for Volc pipeline (ms unless noted).
# VITE_VOLC_PREVIEW_WINDOW_MS=2800
# VITE_VOLC_PREVIEW_MIN_NEW_MS=450
# VITE_VOLC_PREVIEW_MAX_CHUNKS=120
# VITE_VOLC_COMMIT_WINDOW_MS=8000
# VITE_VOLC_COMMIT_MIN_GAP_MS=2600
# VITE_VOLC_COMMIT_MIN_NEW_MS=1400
# VITE_VOLC_COMMIT_MAX_WINDOW_MS=14000
# VITE_VOLC_COMMIT_OVERLAP_MS=1500
# Volc incremental commit watchdog if VAD does not emit a pause (ms).
# VITE_VOLC_COMMIT_FORCE_GAP_MS=4800

# Conversation-aware pause before Volc commit (tie acoustic silence to rolling preview tails).
# VITE_VOLC_CHAT_PAUSE_SENTENCE_MS=700
# VITE_VOLC_CHAT_PAUSE_CLAUSE_MS=950
# VITE_VOLC_CHAT_PAUSE_INCOMPLETE_MS=1500
# Draft bubble shaping before finalization.
# VITE_VOLC_DRAFT_FRAGMENT_MIN_CHARS=12
# VITE_VOLC_DRAFT_BUFFER_HOLD_MS=2200
# VITE_VOLC_DRAFT_BUFFER_MAX_GAP_MS=2600
# VITE_VOLC_DRAFT_SPEAKER_CONFIDENCE_MIN=0.62
# Periodic full-audio refresh while recording (A+B strategy).
# VITE_VOLC_REFRESH_MIN_GAP_MS=25000
# VITE_VOLC_REFRESH_MIN_NEW_MS=9000

# Optional local voiceprint registry (backend).
# VOICEPRINT_DB_PATH=diarization-service/data/voiceprints.json
# VOICEPRINT_MATCH_THRESHOLD=0.82
# VOICEPRINT_MIN_IDENTIFY_MS=900
# VOICEPRINT_SHORT_UTTERANCE_MS=1600
# VOICEPRINT_STRONG_MATCH_THRESHOLD=0.90
# VOICEPRINT_MIN_MARGIN=0.035
# VOICEPRINT_SMOOTH_GAP_MS=1200
# Live-only Volc commit speaker linking (session-scoped, not persisted).
# SESSION_VOICEPRINT_MATCH_THRESHOLD=0.80
# SESSION_VOICEPRINT_STRONG_MATCH_THRESHOLD=0.88
# SESSION_VOICEPRINT_MIN_MARGIN=0.025
# SESSION_VOICEPRINT_MIN_IDENTIFY_MS=550
# SESSION_VOICEPRINT_MAX_SPEAKERS=6
# SESSION_VOICEPRINT_EXPIRE_SECONDS=1800

# Volc post-merge: drop cross-speaker partial duplicates (opening line split, etc.).
# VOLC_PARTIAL_DUP_WINDOW_MS=6500
# VOLC_PARTIAL_DUP_PAD_MS=2600
# VOLC_PARTIAL_DUP_MIN_LEN=14
# VOLC_PARTIAL_DUP_MAX_SHORT_RATIO=0.72
# VOLC_TAIL_FRAGMENT_GAP_MS=3200
# VOLC_TAIL_FRAGMENT_MAX_RATIO=0.45
# VOLC_TAIL_FRAGMENT_MIN_CHARS=6

# Doubao / Volc backend env vars (set in diarization-service runtime env/.env)
# VOLC_APP_ID=
# VOLC_ACCESS_TOKEN=
# VOLC_SECRET_KEY=
# VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async

# Meeting summary / entity extraction API (frontend -> diarization-service).
# VITE_SUMMARY_API_BASE=http://localhost:8090
# VITE_SUMMARY_TIMEOUT_MS=30000
# VITE_USE_MOCK_CLIENTS=true
# VITE_USE_INDEXEDDB=true

# Summary provider env vars (configured in diarization-service/.env at runtime).
# SUMMARY_PROVIDER=openai
# SUMMARY_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# For China egress: SUMMARY_PROVIDER=volc_ark + VOLC_ARK_API_KEY + VOLC_ARK_BASE_URL (see diarization-service/.env.example)
